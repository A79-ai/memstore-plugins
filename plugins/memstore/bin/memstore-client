#!/bin/sh
# What the plugin runs for every hook, its MCP server and its commands: memstore-client where it is installed, and
# where it isn't, it installs it from the public releases (bin/install.sh) and runs that. Never a full `memstore` on
# the PATH instead: that one is whatever its owner last built or installed, often older than the plugin.
#
# Never in the person's way: a hook with nothing installed doesn't wait for a download. A session's start installs
# in the background and says once that the memory is on from the next session; the other hooks do nothing. The MCP
# server and the commands, which can't run without it, install first (a few MB) and then run.
#
#   memstore-client <args>   as memstore-client would run them
#   memstore-client login [<server>] [--org <org>]
#                            signs in: the server and org default to MEMSTORE_URL and MEMSTORE_ORG
here=$(cd "$(dirname "$0")" && pwd)
dir=${MEMSTORE_INSTALL_DIR:-$HOME/.local/bin}
# The installer's lock and log, in the user's own directory: never a fixed name in a shared /tmp.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/memstore

find_bin() {
  for b in "$dir/memstore-client" "$(command -v memstore-client 2>/dev/null)"; do
    # Not this script, which is on PATH as memstore-client where the host adds the plugin's bin/.
    [ -n "$b" ] && [ -x "$b" ] && [ "$(cd "$(dirname "$b")" && pwd)" != "$here" ] && { echo "$b"; return; }
  done
}

install() {
  # One install at a time: every hook of every open session may find it missing at once.
  mkdir -p "$cache" && chmod 700 "$cache" || return 1
  lock=$cache/install.lock
  # A lock an install killed midway left behind doesn't block the next for good.
  find "$lock" -maxdepth 0 -mmin +10 -exec rmdir {} \; 2>/dev/null
  mkdir "$lock" 2>/dev/null || return 1
  trap 'rmdir "$lock" 2>/dev/null' EXIT
  sh "$here/install.sh" >"$cache/install.log" 2>&1
  status=$?
  rmdir "$lock" 2>/dev/null
  trap - EXIT
  return $status
}

# Keeps the client current, in the background, at most once a day: where the latest release isn't the one
# installed (`memstore-client --version` names it), installs it. A pinned MEMSTORE_VERSION, or
# MEMSTORE_CLIENT_UPDATE=off, leaves it as it is.
update() {
  [ -z "${MEMSTORE_VERSION:-}" ] && [ "${MEMSTORE_CLIENT_UPDATE:-on}" != off ] || return 0
  mkdir -p "$cache" && chmod 700 "$cache" || return 0
  stamp=$cache/update-checked
  [ -z "$(find "$stamp" -mmin -1440 2>/dev/null)" ] || return 0
  : >"$stamp"
  repo=${MEMSTORE_CLIENT_REPO:-A79-ai/memstore-plugins}
  latest=$(curl -fsSI --max-time 10 "https://github.com/$repo/releases/latest" 2>/dev/null |
    tr -d '\r' | sed -n 's#^[Ll]ocation: .*/releases/tag/##p')
  [ -n "$latest" ] || return 0
  [ "$("$1" --version 2>/dev/null | cut -d' ' -f2)" = "$latest" ] && return 0
  MEMSTORE_VERSION=$latest install
}

bin=$(find_bin)
if [ -n "$bin" ] && [ "$1 $2" = "hook session-start" ]; then
  (update "$bin" </dev/null >/dev/null 2>&1 &)
fi
if [ -z "$bin" ]; then
  case "$1 $2" in
    "hook session-start")
      # The installer outlives this hook: the person's session starts at once.
      (install </dev/null >/dev/null 2>&1 &)
      printf '%s\n' "memstore (the team memory) is being installed in the background (memstore-client, to $dir). Tell the user once, briefly: it is on from their next session, and if they haven't signed in to the team's memory on this machine, /memstore:login does it. Then carry on with their request."
      exit 0
      ;;
    hook\ *) exit 0 ;;
  esac
  install || {
    echo "memstore-client isn't installed and installing it failed: see $cache/install.log, or install it with: curl -fsSL https://raw.githubusercontent.com/A79-ai/memstore-plugins/main/install.sh | sh" >&2
    exit 1
  }
  bin=$(find_bin)
fi

if [ "$1" = login ]; then
  shift
  server=${MEMSTORE_URL:-}
  case "$1" in http*) server=$1; shift ;; esac
  [ -n "$server" ] || {
    echo "which server? /memstore:login <server> --org <org> (or set MEMSTORE_URL and MEMSTORE_ORG)" >&2
    exit 1
  }
  case " $* " in
    *" --org "*) exec "$bin" join "$server" "$@" ;;
  esac
  [ -n "$MEMSTORE_ORG" ] && exec "$bin" join "$server" --org "$MEMSTORE_ORG" "$@"
  exec "$bin" join "$server" "$@"
fi
exec "$bin" "$@"
